# Database
DATABASE_URL="file:./dev.db"

# JWT (used after Firebase token exchange)
JWT_SECRET="change-this-jwt-secret"
JWT_REFRESH_SECRET="change-this-refresh-secret"

# Admin account — this email gets SUPER_ADMIN on Firebase login
ADMIN_EMAIL="radioninada@gmail.com"

# Firebase Admin SDK (from Firebase Console → Project Settings → Service Accounts)
FIREBASE_PROJECT_ID="radioninadhawebapp"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@radioninadhawebapp.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500"
