# ------------ Backend / Serverless API (.env) ------------
# Database Connection (SQLite for local, PostgreSQL/MySQL for production if configured)
DATABASE_URL="file:./dev.db"

# JWT Token Secrets
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-jwt-key"

# Admin account email
ADMIN_EMAIL="radioninada@gmail.com"

# Firebase Admin SDK credentials (From Firebase Console -> Service Accounts)
FIREBASE_PROJECT_ID="radioninadhawebapp"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@radioninadhawebapp.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# CORS configuration
CORS_ORIGIN="*"


# ------------ Admin Frontend (.env.local) ------------
# Firebase Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDWX5K8hr13D9SgjW-YgeMXhZfVdQzJwlQ"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="radioninadhawebapp.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="radioninadhawebapp"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="radioninadhawebapp.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="318228825550"
NEXT_PUBLIC_FIREBASE_APP_ID="1:318228825550:web:fe3286caeadf741b30d79f"

# Admin Email
NEXT_PUBLIC_ADMIN_EMAIL="radioninada@gmail.com"

# API Base URL (leave blank in production to use relative /api endpoint)
